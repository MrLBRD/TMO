{
  "manifest_version": 3,
  "name": "TMO Woo Admin Cleaner",
  "version": "1.3.2",
  "description": "Ferme les onglets wc-better-management ouverts par la station, en conservant le plus récent.",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nettoyer les onglets Woo"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "content_scripts": [
    {
      "matches": ["*://*/wp-admin/admin.php*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "cleanup-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Fermer les onglets wc-better-management en trop"
    },
    "trigger-print-global": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Imprimer l'étiquette (raccourci global, hors focus)",
      "global": true
    }
  }
}
